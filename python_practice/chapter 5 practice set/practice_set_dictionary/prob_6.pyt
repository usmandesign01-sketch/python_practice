'''Problem 6 — Dictionary Methods

Using the same dictionary, print:

All keys
All values
All key-value pairs

Use:

.keys()
.values()
.items()

Don't just print the dictionary itself.'''

std = {
    "name": "Usman",
    "age": 18,
    "city": "Swat"
}
print(std.keys())
print(std.values())
print(std.items())